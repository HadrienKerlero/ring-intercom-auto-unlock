# Get it with: npx ring-auth-cli
RING_REFRESH_TOKEN=

# Delay (in seconds) between the ding and the unlock
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=20

# After an unlock, ignore new dings for this many seconds
COOLDOWN_SECONDS=60

# Auto-unlock is only active in these time windows
# Days: 1=Monday ... 7=Sunday
ACTIVE_DAYS=1,2,3,4,5
# One or more hour ranges (start inclusive, end exclusive)
# e.g. "8-20", or "8-12,13-20" to pause for lunch
ACTIVE_HOURS=8-20
TIMEZONE=Europe/Rome

# Logging: info or debug (debug also enables ring-client-api internal logs)
LOG_LEVEL=info
# Log an "I'm alive" line every N minutes (0 = never)
HEARTBEAT_MINUTES=60
